# ============================================================================
# AI OPTIONS TRADING PLATFORM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in actual values
# NEVER commit .env with real credentials
# ============================================================================

# ============================================================================
# APPLICATION MODE
# ============================================================================
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=DEBUG  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# CRITICAL: Safety Defaults
PAPER_TRADING=true              # Set to true for paper trading only
LIVE_TRADING_ENABLED=false      # MUST be false to start
TRADING_MODE=PAPER              # PAPER or LIVE (only used if LIVE_TRADING_ENABLED=true)

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=options_trading
DB_USER=trader
DB_PASSWORD=change_me_in_production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false  # Set to true for SQL logging

# TimescaleDB Configuration
TIMESCALE_ENABLED=true
TIMESCALE_CHUNK_INTERVAL=1 day

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_POOL_SIZE=10

# ============================================================================
# MARKET DATA CONFIGURATION
# ============================================================================
# Data Provider Selection
MARKET_DATA_PROVIDER=zerodha  # Options: zerodha, broker-api, csv-simulator
DATA_FEED_TYPE=websocket      # websocket or polling

# Market Hours (Asia/Kolkata)
MARKET_TIMEZONE=Asia/Kolkata
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
PRE_MARKET_START=09:00
PRE_MARKET_END=09:15
POST_MARKET_START=15:30
POST_MARKET_END=16:00

# Data Freshness
DATA_STALE_THRESHOLD_SECONDS=10
DATA_VALIDATION_ENABLED=true

# Instruments
NIFTY_SYMBOL=NIFTY50
NIFTY_INDEX_SYMBOL=NIFTY%2050
SENSEX_SYMBOL=SENSEX
SENSEX_INDEX_SYMBOL=BSE%20SENSEX
BANKNIFTY_SYMBOL=BANKNIFTY

# Candle Intervals to Track (comma-separated)
CANDLE_INTERVALS=1,3,5,15,30,60,1D

# ============================================================================
# DATA PROVIDER - ZERODHA (If using Zerodha)
# ============================================================================
# Get these from your Zerodha account
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_USER_ID=
ZERODHA_PASSWORD=
ZERODHA_2FA=
ZERODHA_PIN=

# ============================================================================
# DATA PROVIDER - CSV SIMULATOR (For testing)
# ============================================================================
CSV_DATA_PATH=./data/csv
CSV_SIMULATOR_ENABLED=false

# ============================================================================
# BROKER CONFIGURATION
# ============================================================================
# Broker: zerodha, shoonya, fyers, etc.
BROKER_NAME=zerodha
BROKER_API_KEY=
BROKER_API_SECRET=
BROKER_USER_ID=
BROKER_PASSWORD=

# Broker Connection
BROKER_API_TIMEOUT=30
BROKER_RETRY_COUNT=3
BROKER_RETRY_DELAY=1

# ============================================================================
# TRADING CONFIGURATION
# ============================================================================

# Account Risk Management
MAX_ACCOUNT_RISK_PER_TRADE=0.01      # 1% of account per trade
MAX_DAILY_LOSS_PERCENT=0.02          # 2% daily loss limit
MAX_DAILY_PROFIT_PERCENT=0.05        # 5% daily profit target
MAX_CONSECUTIVE_LOSSES=3
MAX_TRADES_PER_DAY=10
MAX_OPEN_POSITIONS=2

# Position Sizing
POSITION_SIZING_METHOD=kelly  # kelly, fixed, volatility
KELLY_FRACTION=0.25            # Conservative Kelly fraction

# Order Execution
MAX_SLIPPAGE_PERCENT=0.5       # Maximum acceptable slippage
MAX_SPREAD_PERCENT=1.0         # Maximum acceptable bid-ask spread
MIN_LIQUIDITY_OI=10000         # Minimum option chain OI

# Entry/Exit Timing
COOLDOWN_AFTER_LOSS_MINUTES=15
COOLDOWN_AFTER_WIN_MINUTES=5
MAX_HOLDING_TIME_MINUTES=240   # 4 hours max for intraday
MARKET_CLOSE_SQUARE_OFF_TIME=15:25  # Square off time before close

# Stop Loss & Targets
DEFAULT_STOP_LOSS_TYPE=atr     # atr, structure, percentage
DEFAULT_STOP_LOSS_ATR_MULTIPLIER=2.0
DEFAULT_RISK_REWARD_RATIO=2.0

# News Event Blackout
NEWS_BLACKOUT_ENABLED=true
NEWS_BLACKOUT_MINUTES_BEFORE=30
MAJOR_EVENT_BLACKOUT_MINUTES=30

# ============================================================================
# STRATEGY CONFIGURATION
# ============================================================================
# Enable/disable strategies
STRATEGY_VWAP_TREND_ENABLED=true
STRATEGY_OPENING_BREAKOUT_ENABLED=true
STRATEGY_SUPPORT_RESISTANCE_ENABLED=true
STRATEGY_BREAKOUT_RETEST_ENABLED=true
STRATEGY_MOMENTUM_ENABLED=true
STRATEGY_OPTION_CHAIN_ENABLED=true
STRATEGY_MULTIFRAME_ENABLED=true

# Strategy Weights (for ensemble)
STRATEGY_VWAP_WEIGHT=0.20
STRATEGY_OPENING_BREAKOUT_WEIGHT=0.15
STRATEGY_SUPPORT_RESISTANCE_WEIGHT=0.15
STRATEGY_BREAKOUT_RETEST_WEIGHT=0.15
STRATEGY_MOMENTUM_WEIGHT=0.15
STRATEGY_OPTION_CHAIN_WEIGHT=0.15
STRATEGY_MULTIFRAME_WEIGHT=0.05

# Confidence Thresholds
MIN_TRADE_CONFIDENCE=75        # Minimum confidence to trade (0-100)
MIN_TRADE_LIQUIDITY_SCORE=85   # Minimum liquidity score (0-100)
MIN_TRADE_RISK_REWARD=1.5      # Minimum acceptable R:R

# ============================================================================
# TECHNICAL INDICATORS
# ============================================================================
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
EMA_FAST=9
EMA_MEDIUM=20
EMA_TREND_1=50
EMA_TREND_2=100
EMA_TREND_3=200
ATR_PERIOD=14
BOLLINGER_PERIOD=20
BOLLINGER_STD_DEV=2
ADX_PERIOD=14

# ============================================================================
# OPTION GREEKS & VOLATILITY
# ============================================================================
CALCULATE_GREEKS=true
IV_REFRESH_INTERVAL_SECONDS=5
VEGA_THRESHOLD=0.05            # Filter for IV changes
IV_PERCENTILE_LOOKBACK_DAYS=30

# ============================================================================
# NEWS & SENTIMENT CONFIGURATION
# ============================================================================
NEWS_INTELLIGENCE_ENABLED=false  # Requires news API setup
NEWS_API_PROVIDER=newsapi       # newsapi, bing, custom
NEWS_API_KEY=
NEWS_REFRESH_INTERVAL_MINUTES=5
NEWS_SENTIMENT_MODEL=vader      # vader, transformers
NEWS_IMPACT_WEIGHT=0.10         # Weight in overall signal

# News Sources to Monitor
NEWS_MONITOR_REUTERS=true
NEWS_MONITOR_BLOOMBERG=true
NEWS_MONITOR_CNBC=true
NEWS_MONITOR_MONEYCONTROL=true
NEWS_MONITOR_LIVEMINT=true

# ============================================================================
# GLOBAL MARKET MONITORING
# ============================================================================
GLOBAL_MARKET_MONITORING_ENABLED=false
MONITOR_US_INDICES=true
MONITOR_US_FUTURES=true
MONITOR_GOLD_CRUDE=true
MONITOR_USD_INR=true
MONITOR_YIELDS=true
MONITOR_NIFTY_FUTURES=true

# ============================================================================
# MACHINE LEARNING
# ============================================================================
ML_ENABLED=false               # Wait until Phase 8
ML_MODEL_TYPE=xgboost         # xgboost, lightgbm, neural
ML_PREDICTION_WEIGHT=0.10     # Weight in overall signal
ML_RETRAIN_INTERVAL_DAYS=7
ML_MIN_SAMPLES_TO_TRAIN=500
ML_USE_WALK_FORWARD=true

# ============================================================================
# BACKTESTING
# ============================================================================
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2024-12-31
BACKTEST_INITIAL_CAPITAL=100000
BACKTEST_COMMISSION=20         # Per lot
BACKTEST_SLIPPAGE_PERCENT=0.1
BACKTEST_INCLUDE_TAXES=true
BACKTEST_STT_PERCENT=0.01      # Securities Transaction Tax

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30
API_RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_REQUESTS_PER_MINUTE=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
FRONTEND_API_URL=http://localhost:8000
FRONTEND_WS_URL=ws://localhost:8000

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=change_me

# Logging
LOG_FILE_PATH=./logs
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10
LOG_FORMAT=json              # json or text
STRUCTURED_LOGGING_ENABLED=true

# Error Tracking
ERROR_TRACKING_ENABLED=false
SENTRY_DSN=

# ============================================================================
# SECURITY
# ============================================================================
# JWT
JWT_SECRET_KEY=change_me_in_production_use_strong_key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Key for Internal Services
INTERNAL_API_KEY=change_me_in_production

# Database Encryption
DB_ENCRYPTION_KEY=
ENCRYPT_SENSITIVE_DATA=true

# ============================================================================
# EMERGENCY CONTROLS
# ============================================================================
EMERGENCY_STOP_ENABLED=false
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_ERROR_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=300

# Max Volatility for Trading
MAX_INDIA_VIX=50              # Don't trade if VIX > 50
MIN_LIQUIDITY_FOR_TRADE=true

# ============================================================================
# DEVELOPMENT & TESTING
# ============================================================================
TESTING_MODE=false
MOCK_BROKER=false
MOCK_MARKET_DATA=false
SEED_DATA_ON_START=false

# ============================================================================
# NOTIFICATIONS
# ============================================================================
NOTIFICATIONS_ENABLED=true
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_TO=
NOTIFICATION_SLACK_ENABLED=false
NOTIFICATION_SLACK_WEBHOOK=
NOTIFICATION_TELEGRAM_ENABLED=false
NOTIFICATION_TELEGRAM_TOKEN=
NOTIFICATION_TELEGRAM_CHAT_ID=

# Alert Conditions
ALERT_ON_NEW_SIGNAL=true
ALERT_ON_LARGE_LOSS=true
ALERT_ON_SYSTEM_ERROR=true
ALERT_ON_DATA_ISSUE=true

# ============================================================================
# DATA RETENTION
# ============================================================================
DATA_RETENTION_DAYS=365
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24

# ============================================================================
# ADVANCED OPTIONS
# ============================================================================
# Use with caution - contact support before changing
ADVANCED_IV_SMILE_ADJUSTMENT=false
ADVANCED_VOLATILITY_SURFACE=false
ADVANCED_VOLATILITY_FORECASTING=false
ADVANCED_OPTIONS_PRICING=black_scholes  # black_scholes, binomial
ADVANCED_GAMMA_SCALPING=false

# ============================================================================
# VERSION INFO
# ============================================================================
VERSION=0.1.0-alpha
BUILD_DATE=2026-09-02
